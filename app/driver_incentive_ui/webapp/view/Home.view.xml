<mvc:View controllerName="com.cy.driverincentiveui.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <f:DynamicPage id="dynamicPage">
        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader1">
                <f:content>
                    <fb:FilterBar id="filterbar" useToolbar="false" search=".onSearch" filterChange=".onFilterChange">
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem" name="header/Brand" label="{i18n>filtergroupItemBrandLable}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <ComboBox id="_IDGenComboBox2" placeholder="{i18n>filtergroupItemBrandPlaceholder}" items="{ path: '/Brand' }" >
                                        <core:Item id="_IDGenItem3" key="{Name}" text="{Text}" />
                                    </ComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem1" name="header/Location" label="{i18n>filtergroupItemLocationLable}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                <ComboBox id="_IDGenComboBox4"  placeholder="{i18n>filtergroupItemLoactionPlaceholder}" items="{ path:'/Location' }">
                                        <core:Item id="_IDGenItem4" key="{Name}" text="{Text}"/>
                                </ComboBox>
                                    
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem2" name="header/DateofBusiness" label="{i18n>filtergroupItemDateLabel}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <DateRangeSelection id="DRS1" class="DRS1" change="handleChange" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem3" name="header/Eligibility" label="{i18n>filtergroupItemEligibilityLabel}" groupName="Group1" visibleInFilterBar="true">
                                <fb:control>
                                    <ComboBox id="_IDGenComboBox">
                                        <core:Item id="_IDGenItem1" key="yes" text="{i18n>yes}" />
                                        <core:Item id="_IDGenItem2" key="no" text="{i18n>no}" />
                                    </ComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table id="idIncentiveTable" items="{path:'/IncentiveDetails', parameters:{$expand:'header'}}">
                <headerToolbar>
                    <OverflowToolbar id="_IDGenOverflowToolbar1">
                        <Title id="_IDGenTitle" text="Driver Incentive ({/IncentiveDetails/$count})" />
                        <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                        <Button id="_IDGenButton4" text="{i18n>newDriverIncentive}" type="Accept" enabled="true" press=".onNewDriverIncentiveBtnPress"/>
                        <Button id="_IDGenButton7" icon="sap-icon://excel-attachment" type="Emphasized" press=".onExport" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="_IDGenColumn12" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText3" text="{i18n>columnID}" />
                    </Column>
                    <Column id="_IDGenColumn13" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText14" text="{i18n>columnDate}" />
                    </Column>
                    <Column id="_IDGenColumn14" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText15" text="{i18n>columnBrand}" />
                    </Column>
                    <Column id="_IDGenColumn15" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText16" text="{i18n>columnLocationCode}" />
                    </Column>
                    <Column id="_IDGenColumn16" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText17" text="{i18n>columnLocation}" />
                    </Column>
                    <Column id="_IDGenColumn17" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText18" text="{i18n>columnDriver}" />
                    </Column>
                    <Column id="_IDGenColumn18" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText19" text="{i18n>columnIncentive}" />
                    </Column>
                    <Column id="_IDGenColumn19" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText20" text="{i18n>columnOrderCount}" />
                    </Column>
                    <Column id="_IDGenColumn20" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText21" text="{i18n>columnGSCount}" />
                    </Column>
                    <Column id="_IDGenColumn21" minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
                        <Text id="_IDGenText22" text="{i18n>columnEligibility}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem highlight="{= ${header/Status} === 'Draft' ? 'Information' : 'None' }"  id="_IDGenColumnListItem2" vAlign="Middle" type="Navigation" press=".onItemSelect">
                        <cells >
                            <Text id="_IDGenText23" text="{header/ID}" />
                            <Text id="_IDGenText24" text="{header/DateofBusiness}" />
                            <Text id="_IDGenText25" text="{header/Brand}" />
                            <Text id="_IDGenText26" text="{header/LocationCode}" />
                            <Text id="_IDGenText27" text="{header/Location}" />
                            <Text id="_IDGenText28" text="{EmpNo_ID}" />
                            <Text id="_IDGenText29" text="{IncentiveType}" />
                            <Text id="_IDGenText30" text="{OrderDelivered}" />
                            <Text id="_IDGenText31" text="{}" />
                            <Text id="_IDGenText32" text="{header/Eligibility}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
