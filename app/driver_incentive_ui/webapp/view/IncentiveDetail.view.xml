<mvc:View controllerName="com.cy.driverincentiveui.controller.IncentiveDetail"
	xmlns:m="sap.m"
	xmlns="sap.uxap"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:mvc="sap.ui.core.mvc">
	<ObjectPageLayout id="ObjectPageLayout" showFooter="true">
		<headerTitle>
			<ObjectPageDynamicHeaderTitle id="_IDGenObjectPageDynamicHeaderTitle">
				<expandedHeading>
					<m:Title id="_IDGenTitle1" text="{= ${i18n>requestId} + ' : ' + ${IncentiveItemModel>/ID} }" wrapping="true" />
				</expandedHeading>
				<expandedContent>
					<m:Text id="_IDGenText" text="{i18n>statusSubmitted}" />
				</expandedContent>
				<actions>
					<m:Button id="_IDGenButton" icon="sap-icon://full-screen" press=".onExpandMidCoumn" />
					<m:Button id="_IDGenButton1" icon="sap-icon://decline" press=".onCloseMidColumn" />
				</actions>
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>
		<sections>
			<ObjectPageSection titleUppercase="false" id="idstoreDetails" title="{i18n>storeDetails}">
				<subSections>
					<ObjectPageSubSection id="_IDGenObjectPageSubSection">
						<blocks>
							<f:SimpleForm id="SimpleFormChange480_12120Dual" editable="true" layout="ColumnLayout">
								<f:content>
									<m:Label id="_IDGenLabel" text="{i18n>brand}" />
									<m:Input id="_IDGenInput" value="{brand}" required="true" />
									<m:Label id="_IDGenLabel1" text="{i18n>modEmpNo}" />
									<m:Input id="_IDGenInput1" value="{ID}" required="true" />
									<m:Label id="_IDGenLabel2" text="{i18n>businessDate}" />
									<m:DatePicker id="_IDGenDatePicker" required="true" placeholder="{i18n>enterDate}" change="handleChange" class="sapUiSmallMarginBottom" />
									<m:Label id="_IDGenLabel3" text="{i18n>location}" />
									<m:Input id="_IDGenInput3" value="{}" type="Url" required="true" />
									<m:Label id="_IDGenLabel4" text="{i18n>employeeName}" />
									<m:Input id="_IDGenInput4" value="{}" type="Url" required="true" />
									<m:Label id="_IDGenLabel5" text="{i18n>locationCode}" />
									<m:Input id="_IDGenInput5" value="{}" required="true" />
								</f:content>
							</f:SimpleForm>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>

			<ObjectPageSection id="_IDGenObjectPageSection1">
				<subSections>
					<ObjectPageSubSection id="personalSS1" title="{i18n>driverDetails}" titleUppercase="false">
						<blocks>
							<m:Table id="_IDGenTable1" items="{IncentiveItemModel>/items}">
								<m:headerToolbar>
									<m:OverflowToolbar id="_IDGenOverflowToolbar">
										<m:ToolbarSpacer id="_IDGenToolbarSpacer" />
										<m:Button id="_IDGenButton2" text="{i18n>add}" icon="sap-icon://add" type="Accept" press=".onAddDriver" />
										<m:Button id="_IDGenButton3" icon="sap-icon://simulate" type="Neutral" text="{i18n>calculate}" press=".onCalculate" />
									</m:OverflowToolbar>
								</m:headerToolbar>
								<m:columns>
									<m:Column id="_IDGenColumn" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel6" wrapping="true" text="{i18n>employeeNo}" required="true" />
										<m:footer  ><m:Text id="_IDGenText1" text="{i18n>total}" /></m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn1" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel7" wrapping="true" text="{i18n>employeeName}" required="true" />
									</m:Column>
									<m:Column id="_IDGenColumn2" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel8" wrapping="true" text="{i18n>chipsyEmpNo}" required="true" />
									</m:Column>
									<m:Column id="_IDGenColumn3" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel9" wrapping="true" text="{i18n>incentiveType}" required="true" />
									</m:Column>
									<m:Column id="_IDGenColumn4" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel10" wrapping="true" text="{i18n>orderDelivered}" required="true" />
										<m:footer><m:Text id="_IDGenText2" text="{IncentiveHeaderModel>/totalOrderDelivered}" /></m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn5" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel11" text="{i18n>cdmCashReceived}" required="true" />
										<m:footer><m:Text id="_IDGenText4" text="{IncentiveHeaderModel>/totalCdmCashRecieved}" /></m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn6" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel12"  wrapping="true" text="{i18n>cdmIncentiveCost}" required="true" />
										<m:footer><m:Text id="_IDGenText5" text="{IncentiveHeaderModel>/totalCdmIncentive}" /></m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn7" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel13" wrapping="true" text="{i18n>cdmCashDeposit}" required="true" />
										<m:footer><m:Text id="_IDGenText6" text="{IncentiveHeaderModel>/totalCdmCashDeposit}" /></m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn8" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel14" wrapping="true" text="{i18n>action}" />
									</m:Column>
								</m:columns>
								<m:items>
									<m:ColumnListItem id="_IDGenColumnListItem1">
										<m:cells>
											<m:Input id="_IDGenInput6" value="{IncentiveItemModel>EmpNo}" />
											<m:Text id="_IDGenText7" text="{IncentiveItemModel>EmpName}" />
											<m:Input id="_IDGenInput7" value="{IncentiveItemModel>GSEmp}" />
											<m:ComboBox id="_IDGenComboBox1" required="true" selectedKey="{IncentiveItemModel>IncentiveType}" items="{path: 'IncentiveModel>/IncentiveType', templateShareable: true}">
												<core:Item id="_IDGenItem" key="{IncentiveModel>key}" text="{IncentiveModel>text}" />
											</m:ComboBox>
											<m:Input id="_IDGenInput8" type="Number" value="{IncentiveItemModel>OrderDelivered}" required="true" />
											<m:Input id="_IDGenInput9" type="Number" value="{IncentiveItemModel>CDMCashReceived}" required="true" />
											<m:Input id="_IDGenInput10" type="Number" value="{IncentiveItemModel>CDMIncentiveCost}" required="true" editable="false" />
											<m:Input id="_IDGenInput11" type="Number" value="{IncentiveItemModel>CDMCashDeposit}" required="true" editable="false" />
											<m:HBox id="_IDGenHBox" gap="5%">
												<m:Button id="_IDGenButton5" icon="sap-icon://edit" type="Accept" />
												<m:Button id="_IDGenButton6" icon="sap-icon://decline" type="Reject" press=".onDeleteRow" />
											</m:HBox>
										</m:cells>
									</m:ColumnListItem>
								</m:items>
							</m:Table>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>

			<ObjectPageSection id="_IDGenObjectPageSection">
				<subSections>
					<ObjectPageSubSection id="_IDGenObjectPageSubSection1" title="{i18n>incentiveSummary}">
						<blocks>
							<m:Table id="_IDGenTable" items="{IncentiveSummaryModel>/items}">
								<m:columns>
									<m:Column id="_IDGenColumn9" demandPopin="true" minScreenWidth="Tablet" hAlign="Center">
										<m:Label id="_IDGenLabel15" wrapping="true" text="{i18n>incentiveType}" />
										<m:footer><m:Text id="_IDGenText8" text="{i18n>total}" /></m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn10" demandPopin="true" minScreenWidth="Tablet" hAlign="Center">
										<m:Label id="_IDGenLabel16" wrapping="true" text="{i18n>noOfOrders}" />
										<m:footer><m:Text id="_IDGenText9" text="{IncentiveHeaderModel>/totalOrderDelivered}" /></m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn11" demandPopin="true" minScreenWidth="Tablet" hAlign="Center">
										<m:Label id="_IDGenLabel17" wrapping="true" text="{i18n>incentive}" />
										<m:footer><m:Text id="_IDGenText10" text="{IncentiveHeaderModel>/totalCdmIncentive}" /></m:footer>
									</m:Column>
								</m:columns>
								<m:items>
									<m:ColumnListItem id="_IDGenColumnListItem3">
										<m:cells>
											<m:Text id="_IDGenText11" text="{IncentiveSummaryModel>incentiveType}" />
											<m:Text id="_IDGenText12" text="{IncentiveSummaryModel>noOfOrders}" />
											<m:Text id="_IDGenText13" text="{IncentiveSummaryModel>incentive}" />
										</m:cells>
									</m:ColumnListItem>
								</m:items>
							</m:Table>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
		<footer>
			<m:OverflowToolbar id="_IDGenOverflowToolbar3" >
			<m:ToolbarSpacer id="_IDGenToolbarSpacer2"/>
			<m:Button id="_IDGenButton8" text="Submit" icon="sap-icon://save" type="Accept" />
			<m:Button id="_IDGenButton9" text="Save as Draft" type="Emphasized" />
			</m:OverflowToolbar>
		</footer>
	</ObjectPageLayout>
</mvc:View>
