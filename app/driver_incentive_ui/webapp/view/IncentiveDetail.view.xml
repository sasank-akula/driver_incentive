<mvc:View controllerName="com.cy.driverincentiveui.controller.IncentiveDetail"
	xmlns:m="sap.m"
	xmlns="sap.uxap"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:mvc="sap.ui.core.mvc">
	<ObjectPageLayout id="ObjectPageLayout" showFooter="true">
		<dependents>
			<core:CommandExecution id="CE_FOCUS_MESSAGE_POPOVER" command="FocusMessagePopover" enabled="true" execute=".onFocusMessagePopover" />
		</dependents>
		<headerTitle>
			<ObjectPageDynamicHeaderTitle id="_IDGenObjectPageDynamicHeaderTitle">
				<expandedHeading>
					<m:Title id="_IDGenTitle1" text="{= ${i18n>requestId} + ' : ' + ${IncentiveHeaderModel>/ID}}" wrapping="true" />
				</expandedHeading>
				<expandedContent>
					<m:Text id="_IDGenText" text="Status : {IncentiveHeaderModel>/Status}" />
				</expandedContent>
				<actions>
					<m:Button id="_IDGenButton" icon="sap-icon://full-screen" press=".onExpandMidCoumn" />
					<m:Button id="_IDGenButton1" icon="sap-icon://decline" press=".onCloseMidColumn" />
				</actions>
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>
		<sections>
			<ObjectPageSection titleUppercase="false" id="idstoreDetails" title="{i18n>storeDetails}">
				<subSections>
					<ObjectPageSubSection id="_IDGenObjectPageSubSection">
						<blocks>
							<f:SimpleForm id="SimpleFormChange480_12120Dual" layout="ColumnLayout">
								<f:content>
									<m:Label id="_IDGenLabel" text="{i18n>brand}" />
									<m:ComboBox id="_IDGenComboBox5" enabled="{LocalModel>/enabled}" fieldGroupIds="fgCombo" required="true" selectedKey="{IncentiveHeaderModel>/Brand}" items="{ path:'/Brand', templateShareable:true}">
										<core:Item id="_IDGenItem5" key="{Name}" text="{Text}" />
									</m:ComboBox>
									<m:Label id="_IDGenLabel1" text="{i18n>modEmpNo}" />
									<m:Input id="_IDGenInput1" enabled="{LocalModel>/enabled}" fieldGroupIds="fgInput" value="{IncentiveHeaderModel>/MOD_Emp}" required="true" />
									<m:Label id="_IDGenLabel2" text="{i18n>businessDate}" />
									<m:DatePicker id="_IDGenDatePicker" enabled="{LocalModel>/enabled}" fieldGroupIds="fgDate" required="true" value="{IncentiveHeaderModel>/DateofBusiness}" valueFormat="yyyy-MM-dd" placeholder="{i18n>enterDate}" class="sapUiSmallMarginBottom" />
									<m:Label id="_IDGenLabel3" text="{i18n>location}" />
									<m:ComboBox id="_IDGenComboBox6" enabled="{LocalModel>/enabled}" fieldGroupIds="fgCombo" required="true" selectedKey="{IncentiveHeaderModel>/Location}" items="{ path:'/Location', templateShareable:true}">
										<core:Item id="_IDGenItem6" key="{Name}" text="{Text}" />
									</m:ComboBox>
									<m:Label id="_IDGenLabel4" text="{i18n>employeeName}" />
									<m:Input id="_IDGenInput4" enabled="{LocalModel>/enabled}" fieldGroupIds="fgInput" value="{IncentiveHeaderModel>/EmployeeName}" type="Url" required="true" />
									<m:Label id="_IDGenLabel5" text="{i18n>locationCode}" />
									<m:Input id="_IDGenInput5" enabled="{LocalModel>/enabled}" fieldGroupIds="fgInput" value="{IncentiveHeaderModel>/LocationCode}" required="true" />
									<m:Label id="_IDGenLabel19"  text="{i18n>filtergroupItemEligibilityLabel}" />
									<m:ComboBox id="_IDGenComboBox3"  enabled="{LocalModel>/enabled}" fieldGroupIds="fgCombo" required="true" selectedKey="{IncentiveHeaderModel>/Eligibility}">
										<core:Item id="_IDGenItem8"  key="Yes" text="{i18n>yes}" />
                                        <core:Item id="_IDGenItem9"  key="No" text="{i18n>no}" />
									</m:ComboBox>
								</f:content>
							</f:SimpleForm>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>

			<ObjectPageSection id="_IDGenObjectPageSection1">
				<subSections>
					<ObjectPageSubSection id="personalSS1" title="{i18n>driverDetails}" titleUppercase="false">
						<blocks>
							<m:Table id="_IDGenTable1" items="{IncentiveItemModel>/items}">
								<m:headerToolbar>
									<m:OverflowToolbar id="_IDGenOverflowToolbar">
										<m:ToolbarSpacer id="_IDGenToolbarSpacer" />
										<m:Button id="_IDGenButton2" text="{i18n>add}" enabled="{LocalModel>/enabled}" icon="sap-icon://add" type="Accept" press=".onAddDriver" />
										<m:Button id="_IDGenButton3" enabled="{LocalModel>/enabled}" icon="sap-icon://simulate" type="Neutral" text="{i18n>calculate}" press=".onCalculate" />
									</m:OverflowToolbar>
								</m:headerToolbar>
								<m:columns>
									<m:Column id="_IDGenColumn" demandPopin="true" minScreenWidth="Tablet" width="15%">
										<m:Label id="_IDGenLabel6" wrapping="true" text="{i18n>employeeNo}" required="true" />
										<m:footer  >
											<m:Text id="_IDGenText1" text="{i18n>total}" />
										</m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn1" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel7" wrapping="true" text="{i18n>employeeName}" required="true" />
									</m:Column>
									<m:Column id="_IDGenColumn2" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel8" wrapping="true" text="{i18n>chipsyEmpNo}" required="true" />
									</m:Column>
									<m:Column id="_IDGenColumn3" demandPopin="true" minScreenWidth="Tablet" width="15%">
										<m:Label id="_IDGenLabel9" wrapping="true" text="{i18n>incentiveType}" required="true" />
									</m:Column>
									<m:Column id="_IDGenColumn4" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel10" wrapping="true" text="{i18n>orderDelivered}" required="true" />
										<m:footer>
											<m:Text id="_IDGenText2" text="{IncentiveHeaderModel>/OrderDeliveredTotal}" />
										</m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn5" demandPopin="true" minScreenWidth="Tablet">
										<m:Label wrapping="true" id="_IDGenLabel11" text="{i18n>cdmCashReceived}" required="true" />
										<m:footer>
											<m:Text id="_IDGenText4" text="{IncentiveHeaderModel>/CDMCashReceivedTotal}" />
										</m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn6" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel12" wrapping="true" text="{i18n>cdmIncentiveCost}" required="true" />
										<m:footer>
											<m:Text id="_IDGenText5" text="{IncentiveHeaderModel>/CDMIncentiveCostTotal}" />
										</m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn7" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel13" wrapping="true" text="{i18n>cdmCashDeposit}" required="true" />
										<m:footer>
											<m:Text id="_IDGenText6" text="{IncentiveHeaderModel>/CDMCashDepositTotal}" />
										</m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn8" demandPopin="true" minScreenWidth="Tablet">
										<m:Label id="_IDGenLabel14" wrapping="true" text="{i18n>action}" />
									</m:Column>
								</m:columns>
								<m:items>
									<m:ColumnListItem id="_IDGenColumnListItem1" vAlign="Middle" type="Inactive">
										<m:cells>
											<m:Input fieldGroupIds="fgInput" id="_IDGenInput6" enabled="{LocalModel>/enabled}" required="true" value="{IncentiveItemModel>EmpNo_ID}" valueHelpIconSrc="sap-icon://search" valueHelpRequest="onEmployeeSearch" showValueHelp="true"/>
											<m:Text fieldGroupIds="fgText" id="_IDGenText7" text="{IncentiveItemModel>EmpName}" />
											<m:Input fieldGroupIds="fgInput" id="_IDGenInput7" enabled="{LocalModel>/enabled}" value="{IncentiveItemModel>GSEmp}" />
											<m:ComboBox fieldGroupIds="fgCombo" id="_IDGenComboBox1" enabled="{LocalModel>/enabled}" required="true" selectedKey="{IncentiveItemModel>IncentiveType}" items="{path: '/IncentiveType', templateShareable: true}">
												<core:Item id="_IDGenItem" key="{Name}" text="{Text}" />
											</m:ComboBox>
											<m:Input fieldGroupIds="fgInput" id="_IDGenInput8" enabled="{LocalModel>/enabled}" type="Number" value="{IncentiveItemModel>OrderDelivered}" required="true" />
											<m:Input fieldGroupIds="fgInput" id="_IDGenInput9" enabled="{LocalModel>/enabled}" type="Number" value="{IncentiveItemModel>CDMCashReceived}" required="true" />
											<m:Input fieldGroupIds="fgInput" id="_IDGenInput10" enabled="{LocalModel>/enabled}" type="Number" value="{IncentiveItemModel>CDMIncentiveCost}" required="true" editable="false" />
											<m:Input fieldGroupIds="fgInput" id="_IDGenInput11" enabled="{LocalModel>/enabled}" type="Number" value="{IncentiveItemModel>CDMCashDeposit}" required="true" editable="false" />
											<m:HBox id="_IDGenHBox" gap="5%">
												<m:Button enabled="{LocalModel>/enabled}" id="_IDGenButton5" icon="sap-icon://edit" type="Accept" />
												<m:Button enabled="{LocalModel>/enabled}" id="_IDGenButton6" icon="sap-icon://decline" type="Reject" press=".onDeleteRow" />
											</m:HBox>
										</m:cells>
									</m:ColumnListItem>
								</m:items>
							</m:Table>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>

			<ObjectPageSection id="_IDGenObjectPageSection">
				<subSections>
					<ObjectPageSubSection id="_IDGenObjectPageSubSection1" title="{i18n>incentiveSummary}">
						<blocks>
							<m:Table id="_IDGenTable" items="{IncentiveSummaryModel>/items}">
								<m:columns>
									<m:Column id="_IDGenColumn9" demandPopin="true" minScreenWidth="Tablet" hAlign="Center">
										<m:Label id="_IDGenLabel15" wrapping="true" text="{i18n>incentiveType}" />
										<m:footer>
											<m:Text id="_IDGenText8" text="{i18n>total}"/>
										</m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn10" demandPopin="true" minScreenWidth="Tablet" hAlign="Center">
										<m:Label id="_IDGenLabel16" wrapping="true" text="{i18n>noOfOrders}" />
										<m:footer>
											<m:Text id="_IDGenText9" text="{IncentiveHeaderModel>/OrderDeliveredTotal}" />
										</m:footer>
									</m:Column>
									<m:Column id="_IDGenColumn11" demandPopin="true" minScreenWidth="Tablet" hAlign="Center">
										<m:Label id="_IDGenLabel17" wrapping="true" text="{i18n>incentive}" />
										<m:footer>
											<m:Text id="_IDGenText10" text="{IncentiveHeaderModel>/CDMIncentiveCostTotal}" />
										</m:footer>
									</m:Column>
								</m:columns>
								<m:items>
									<m:ColumnListItem id="_IDGenColumnListItem3">
										<m:cells>
											<m:Text id="_IDGenText11" text="{IncentiveSummaryModel>IncentiveType}" />
											<m:Text id="_IDGenText12" text="{IncentiveSummaryModel>NoOfOrders}" />
											<m:Text id="_IDGenText13" text="{IncentiveSummaryModel>Incentive}" />
										</m:cells>
									</m:ColumnListItem>
								</m:items>
							</m:Table>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
		<footer >
			<m:OverflowToolbar id="_IDGenOverflowToolbar3" visible="{LocalModel>/enabled}">
			 <m:Button
                    id="messageButton"
                    icon="sap-icon://message-popup"
                    text="{message>/length}"
                    type="Emphasized"
                    press="onShowMessages"
                    visible="{= ${message>/}.length > 0 }"
                />
				
				<m:ToolbarSpacer id="_IDGenToolbarSpacer2"/>
				<m:Button id="_IDGenButton8" enabled="{LocalModel>/enabled}" press="onSubmit($event,'SUBMIT')" text="Submit" icon="sap-icon://save" type="Accept" />
				<m:Button id="_IDGenButton9" enabled="{LocalModel>/enabled}" press="onSubmit($event,'Draft')" text="Save as Draft" type="Emphasized" />
			</m:OverflowToolbar>
		</footer>
	</ObjectPageLayout>
</mvc:View>
