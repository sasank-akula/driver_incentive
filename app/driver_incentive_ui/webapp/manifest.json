{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.cy.driverincentiveui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.18.1",
      "toolsId": "d0400631-c3c3-47c0-a8ab-f6973cf01e65"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/incentive/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "driver-Display": {
          "semanticObject": "driver",
          "action": "Display",
          "title": "{{driver-Display.flpTitle}}",
          "subTitle": "{{driver-Display.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        },
        "driverIncentive-Display": {
          "semanticObject": "driverIncentive",
          "action": "Display",
          "title": "{{driverIncentive-Display.flpTitle}}",
          "subTitle": "{{driverIncentive-Display.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "commands": {
			"FocusMessagePopover": {
				"shortcut": "Ctrl+Shift+M"
			}
		},
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.cy.driverincentiveui.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "IncentiveItemModel": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {"defaultBindingMode": "TwoWay"},
        "preload": false
      },
      "IncentiveHeaderModel": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {"defaultBindingMode": "TwoWay"},
        "preload": false
      },
      "message": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {"defaultBindingMode": "TwoWay"},
        "preload": false
      },
      "IncentiveModel": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/incentiveModel.json",
        "settings": {"defaultBindingMode": "TwoWay"},
        "preload": false
      },
      "IncentiveSummaryModel": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {"defaultBindingMode": "TwoWay"},
        "preload": false
      }, 
      "LocalModel": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {"defaultBindingMode": "TwoWay"},
        "preload": false
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlId": "layout",
        "controlAggregation": "beginColumnPages",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.cy.driverincentiveui.view",
        "async": true
      },
      "routes": [
        {
          "name": "RouteHome",
          "pattern": ":?query:",
          "target": [
            "TargetHome"
          ]
        },
        {
          "name": "RouteDetail",
          "pattern": "RouteDetail/{ID}",
          "target": [
            "TargetHome",
            "TargetDetail"
          ]
        }
      ],
      "targets": {
        "TargetHome": {
          "id": "Home",
          "viewType": "XML",
          "level": 1,
          "viewName": "Home",
          "controlAggregation": "beginColumnPages"
        },
        "TargetDetail": {
          "id": "IncentiveDetail",
          "viewType": "XML",
          "level": 1,
          "viewName": "IncentiveDetail",
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "rootView": {
      "viewName": "com.cy.driverincentiveui.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "driver_incentive"
  }
}
